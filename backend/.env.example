# Copy to .env and fill in values. Never commit .env.

# Supabase — find in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # secret key, not anon key
SUPABASE_ANON_KEY=your-anon-key             # public key, used by scripts/getToken.ts

# Service account — created in Supabase dashboard → Authentication → Users
SERVICE_ACCOUNT_EMAIL=service@your-app.com
SERVICE_ACCOUNT_PASSWORD=your-service-account-password

# Static API key — generate with: openssl rand -hex 32
API_KEY=your-api-key

# Dev scripts only — do not use real patient credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-password

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# AWS (leave blank for local dev — only needed in production)
AWS_REGION=ap-southeast-2
AWS_SECRET_NAME=                             # e.g. ai-scribe/production
