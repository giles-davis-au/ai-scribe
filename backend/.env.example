# Copy to .env and fill in values. Never commit .env.

# Supabase — find in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # secret key, not anon key

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# AWS (leave blank for local dev — only needed in production)
AWS_REGION=ap-southeast-2
AWS_SECRET_NAME=                             # e.g. ai-scribe/production
